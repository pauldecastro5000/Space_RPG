<Window x:Class="Space_RPG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Space_RPG"
        xmlns:views="clr-namespace:Space_RPG.Views"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="1200"
        Width="1920"
        Background="Black"
        WindowState="Maximized">
    <Grid Margin="0,-1,0,1">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- SHIP MAP VIEW -->
        <Border Grid.Row="0"
                Grid.Column="0">
  
        </Border>

        <!-- MAIN VIEW -->
        <Border Grid.Row="0" Grid.Column="1">
            <views:ShipMapView Ship="{Binding MyShip}"
                               Crews="{Binding Crews}" />

        </Border>
        
        <!-- LOGS / CREWS VIEW -->
        <Border Grid.Row="1"
                Grid.Column="1">
            <views:CockpitView Grid.Row="1" />
        </Border>
        
        <!-- COMMANDS VIEW -->
        <Border Grid.Row="1" Grid.Column="2">
            <TabControl>
                <TabItem Header="Ship Commands">

                </TabItem>
                <TabItem Header="Planet Commands">
                    <Button Content="Open Applicants"
                            Grid.Row="1"
                            Width="150"
                            Height="40"
                            Command="{Binding OpenApplicantsCommand}" />
                </TabItem>
                <TabItem Header="Others">
                    <Button Content="Ship Editor"
                            Grid.Row="1"
                            Width="150"
                            Height="40"
                            Command="{Binding ShipEditorCommand}" />
                </TabItem>
            </TabControl>
        </Border>

        <!-- PLANET STATUS VIEW -->
        <Border Grid.Column="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <views:MainView Grid.Row="0"/>
                <views:PlanetView Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- SHIP STATUS VIEW -->
        <Border Grid.Row="1" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <TabControl Grid.Row="0"
                            Background="Black">
                    <TabItem Header="Log"
                             Background="Black">
                        <ScrollViewer ScrollChanged="scrollChanged"
                                      Name="scrollViewer">
                            <ItemsControl ItemsSource="{Binding Log}"
                                          Style="{StaticResource Basic}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="White" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Crew List"
                             Background="Black">
                        <views:CrewListView />
                    </TabItem>

                </TabControl>

                <!-- TEXT COMMAND -->
                <TextBox Grid.Row="1"
                         Background="Black"
                         KeyDown="OnKeyDownHandler"
                         Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="White" />
            </Grid>
        </Border>

    </Grid>
</Window>
