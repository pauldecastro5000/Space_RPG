<Window x:Class="Space_RPG.Windows.ShipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ship Editor"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="Black">

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Background="#111111"
                    HorizontalAlignment="Right">

            <Button Content="Save"
                    Width="100"
                    Height="30"
                    Margin="5"
                    Command="{Binding SaveCommand}" />

        </StackPanel>

        <Grid x:Name="PreviewHost"
              Grid.Row="1"
              Background="Black"
              ClipToBounds="True"
              MouseWheel="PreviewHost_MouseWheel"
              MouseLeftButtonDown="PreviewHost_MouseLeftButtonDown"
              MouseMove="PreviewHost_MouseMove"
              MouseLeftButtonUp="PreviewHost_MouseLeftButtonUp">

            <Grid>

                <!-- GRID -->
                <Canvas x:Name="GridCanvas"
                        Background="Black"
                        Width="1200"
                        Height="900">

                    <Canvas.RenderTransform>

                        <TransformGroup>

                            <ScaleTransform x:Name="PreviewScaleTransform"
                                            ScaleX="1"
                                            ScaleY="1" />

                            <TranslateTransform x:Name="PreviewTranslateTransform"
                                                X="0"
                                                Y="0" />

                        </TransformGroup>

                    </Canvas.RenderTransform>

                </Canvas>

                <!-- SHIP -->
                <Canvas x:Name="PreviewCanvas"
                        Background="Transparent"
                        Width="1200"
                        Height="900"
                        IsHitTestVisible="False">

                    <Canvas.RenderTransform>

                        <TransformGroup>

                            <ScaleTransform ScaleX="{Binding ScaleX, ElementName=PreviewScaleTransform}"
                                            ScaleY="{Binding ScaleY, ElementName=PreviewScaleTransform}" />

                            <TranslateTransform X="{Binding X, ElementName=PreviewTranslateTransform}"
                                                Y="{Binding Y, ElementName=PreviewTranslateTransform}" />

                        </TransformGroup>

                    </Canvas.RenderTransform>

                </Canvas>

            </Grid>

        </Grid>
    </Grid>
</Window>