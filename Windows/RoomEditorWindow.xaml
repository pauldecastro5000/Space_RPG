<Window x:Class="Space_RPG.Windows.RoomEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:Space_RPG.Models"
        Title="Room Editor"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterOwner"
        Background="Black">

    <Window.Resources>

        <!-- ENUM SOURCES -->
        <ObjectDataProvider x:Key="InteriorObjectTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:InteriorObjectType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="InteriorTileTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:InteriorTileType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="FacilityTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:FacilityType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- GLOBAL DARK COMBOBOX -->
        <Style x:Key="DarkDataGridComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}" />

        <!-- TEXT -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="White" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground"
                    Value="White" />
        </Style>

        <!-- GROUPBOX -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Background"
                    Value="#111111" />
            <Setter Property="BorderBrush"
                    Value="#444444" />
        </Style>

        <!-- BUTTON -->
        <Style TargetType="Button">
            <Setter Property="Background"
                    Value="#2B2B2B" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#555555" />

            <Setter Property="Padding"
                    Value="5" />

            <Setter Property="Margin"
                    Value="3" />

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3B3B3B" />

                    <Setter Property="Cursor"
                            Value="Hand" />

                </Trigger>

            </Style.Triggers>
        </Style>

        <!-- TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="#1A1A1A" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#555555" />
        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"
                    Value="#111111" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#444444" />

            <Setter Property="RowBackground"
                    Value="#1A1A1A" />

            <Setter Property="AlternatingRowBackground"
                    Value="#222222" />

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal" />

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#333333" />

            <Setter Property="VerticalGridLinesBrush"
                    Value="#333333" />
        </Style>

        <!-- DATAGRID HEADER -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#2B2B2B" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#555555" />
        </Style>

        <!-- DATAGRID CELL -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="#333333" />
        </Style>

    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>

        <!-- ROOM DETAILS -->
        <GroupBox Header="Room Details"
                  Grid.Row="0">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>

                <Label Content="Name"
                       Grid.Row="0"
                       Grid.Column="0" />

                <TextBox Text="{Binding Name}"
                         Grid.Row="0"
                         Grid.Column="1" />

                <Label Content="Room Type"
                       Grid.Row="0"
                       Grid.Column="2" />

                <ComboBox ItemsSource="{Binding Source={StaticResource FacilityTypeValues}}"
                          SelectedItem="{Binding RoomType}"
                          Grid.Row="0"
                          Grid.Column="3" />

                <Label Content="Width"
                       Grid.Row="1"
                       Grid.Column="0" />

                <TextBox Text="{Binding RoomWidth, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="IntegerOnly_PreviewTextInput"
                         Grid.Row="1"
                         Grid.Column="1" />

                <Label Content="Height"
                       Grid.Row="1"
                       Grid.Column="2" />

                <TextBox Text="{Binding RoomHeight, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="IntegerOnly_PreviewTextInput"
                         Grid.Row="1"
                         Grid.Column="3" />

                <Label Content="World X"
                       Grid.Row="2"
                       Grid.Column="0" />

                <TextBox Text="{Binding WorldX, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="IntegerOnly_PreviewTextInput"
                         Grid.Row="2"
                         Grid.Column="1" />

                <Label Content="World Y"
                       Grid.Row="2"
                       Grid.Column="2" />

                <TextBox Text="{Binding WorldY, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="IntegerOnly_PreviewTextInput"
                         Grid.Row="2"
                         Grid.Column="3" />

            </Grid>

        </GroupBox>

        <!-- OBJECTS -->
        <GroupBox Header="Objects"
                  Grid.Row="1"
                  Margin="0,10,0,0">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="5">

                    <Button Content="Add Object"
                            Width="100"
                            Click="AddObject_Click" />

                    <Button Content="Remove Object"
                            Width="120"
                            Click="RemoveObject_Click" />

                </StackPanel>

                <DataGrid x:Name="ObjectsGrid"
                          ItemsSource="{Binding Objects}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="150" />

                        <DataGridTextColumn Header="X"
                                            Binding="{Binding X}"
                                            Width="60" />

                        <DataGridTextColumn Header="Y"
                                            Binding="{Binding Y}"
                                            Width="60" />

                        <DataGridTextColumn Header="Width"
                                            Binding="{Binding Width}"
                                            Width="70" />

                        <DataGridTextColumn Header="Height"
                                            Binding="{Binding Height}"
                                            Width="70" />

                        <!-- OBJECT TYPE -->
                        <DataGridComboBoxColumn Header="Object Type"
                                                SelectedItemBinding="{Binding ObjectType}"
                                                ItemsSource="{Binding Source={StaticResource InteriorObjectTypeValues}}"
                                                Width="150">

                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource DarkDataGridComboBoxStyle}" />
                            </DataGridComboBoxColumn.ElementStyle>

                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource DarkDataGridComboBoxStyle}" />
                            </DataGridComboBoxColumn.EditingElementStyle>

                        </DataGridComboBoxColumn>

                        <!-- TILE TYPE -->
                        <DataGridComboBoxColumn Header="Tile Type"
                                                SelectedItemBinding="{Binding TileType}"
                                                ItemsSource="{Binding Source={StaticResource InteriorTileTypeValues}}"
                                                Width="150">

                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource DarkDataGridComboBoxStyle}" />
                            </DataGridComboBoxColumn.ElementStyle>

                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource DarkDataGridComboBoxStyle}" />
                            </DataGridComboBoxColumn.EditingElementStyle>

                        </DataGridComboBoxColumn>

                        <DataGridCheckBoxColumn Header="Allow Multiple Crew"
                                                Binding="{Binding AllowMultipleCrew}"
                                                Width="140" />

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </GroupBox>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    Height="30"
                    Click="Cancel_Click" />

            <Button Content="Apply"
                    Width="100"
                    Height="30"
                    Click="Apply_Click" />

        </StackPanel>

    </Grid>

</Window>