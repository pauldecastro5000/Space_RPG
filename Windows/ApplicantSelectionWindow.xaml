<Window x:Class="Space_RPG.Windows.ApplicantSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Applicants"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="15">

        <Button DockPanel.Dock="Bottom"
                Content="Accept"
                Height="40"
                Width="120"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Command="{Binding AcceptCommand}" />

        <ItemsControl ItemsSource="{Binding Applicants}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3"
                                 Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="8"
                            Padding="10">

                        <StackPanel>

                            <CheckBox IsChecked="{Binding IsSelected}"
                                      HorizontalAlignment="Right" />

                            <Image Source="{Binding PhotoPath}"
                                   Height="100"
                                   Stretch="UniformToFill"
                                   Margin="0,5" />

                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="{Binding Age, StringFormat=Age: {0}}" />
                            <TextBlock Text="{Binding Skills, StringFormat=Skills: {0}}" />
                            <TextBlock Text="{Binding Price, StringFormat=Price: ${0}}" />

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </DockPanel>
</Window>