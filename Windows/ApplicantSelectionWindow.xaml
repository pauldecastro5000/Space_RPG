<Window x:Class="Space_RPG.Windows.ApplicantSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Applicants"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="Black"
        WindowState="Maximized">

    <DockPanel Margin="15">

        <Button DockPanel.Dock="Bottom"
                Content="Accept"
                Height="40"
                Width="120"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Command="{Binding AcceptCommand}" />

        <ItemsControl ItemsSource="{Binding Applicants}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3"
                                 Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2"
                            CornerRadius="8"
                            Margin="8"
                            Padding="10"
                            Cursor="Hand"
                            MouseLeftButtonUp="ApplicantBorder_MouseLeftButtonUp">

                        <Border.Style>
                            <Style TargetType="Border">

                                <Setter Property="BorderBrush"
                                        Value="Gray" />
                                <Setter Property="Background"
                                        Value="#222222" />

                                <Style.Triggers>

                                    <!-- Hover -->
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="DarkBlue" />
                                        <Setter Property="BorderThickness"
                                                Value="3" />
                                    </Trigger>

                                    <!-- Selected -->
                                    <DataTrigger Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BorderBrush"
                                                Value="LimeGreen" />
                                        <Setter Property="BorderThickness"
                                                Value="4" />
                                        <Setter Property="Background"
                                                Value="#2E3F2E" />
                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </Border.Style>

                        <StackPanel>

                            <Image Source="{Binding PhotoPath}"
                                   Height="100"
                                   Stretch="UniformToFill"
                                   Margin="0,5" />

                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Foreground="White" />

                            <TextBlock Text="{Binding Age, StringFormat=Age: {0}}"
                                       Foreground="White" />

                            <TextBlock Text="{Binding Skills, StringFormat=Skills: {0}}"
                                       Foreground="White" />

                            <TextBlock Text="{Binding Price, StringFormat=Price: ${0}}"
                                       Foreground="White" />

                        </StackPanel>

                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </DockPanel>
</Window>