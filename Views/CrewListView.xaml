<UserControl x:Class="Space_RPG.Views.CrewListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Black"
          Margin="5">

        <DataGrid ItemsSource="{Binding State.Crews}"
                  SelectedItem="{Binding SelectedCrew, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  Background="Black"
                  Foreground="White"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#2A2A2A"
                  CanUserResizeColumns="False"
                  FontSize="14"
                  ColumnWidth="SizeToCells">

            <!-- HEADER STYLE -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"
                            Value="Black" />
                    <Setter Property="Foreground"
                            Value="White" />
                    <Setter Property="FontSize"
                            Value="20" />
                    <Setter Property="FontWeight"
                            Value="Normal" />
                    <Setter Property="BorderBrush"
                            Value="#404040" />
                    <Setter Property="BorderThickness"
                            Value="0,0,1,1" />
                    <Setter Property="Padding"
                            Value="4,2" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- CELL STYLE -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderBrush"
                            Value="#404040" />
                    <Setter Property="BorderThickness"
                            Value="0,0,1,1" />
                    <Setter Property="Padding"
                            Value="4,2" />

                    <Setter Property="Background"
                            Value="#1E1E1E" />

                    <Setter Property="Foreground"
                            Value="White" />

                    <Style.Triggers>

                        <!-- Selected Row -->
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#3B3B3B" />
                            <Setter Property="Foreground"
                                    Value="White" />
                        </Trigger>

                        <!-- Mouse Hover -->
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#2F2F2F" />
                        </Trigger>

                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- NAME -->
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Width="Auto" />

                <!-- HUNGER -->
                <DataGridTextColumn Header="Hunger"
                                    Binding="{Binding Hunger, StringFormat=F1}"
                                    IsReadOnly="True"
                                    Width="Auto" />

                <!-- FATIGUE -->
                <DataGridTextColumn Header="Fatigue"
                                    Binding="{Binding Fatigue, StringFormat=F1}"
                                    IsReadOnly="True"
                                    Width="Auto" />

                <!-- JOB -->
                <DataGridTemplateColumn Header="Job"
                                        Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Job}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Padding="4,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Job, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.JobOptions,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      Background="Black"
                                      Foreground="White" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- JOB STATUS -->
                <DataGridTextColumn Header="Job Status"
                                    Binding="{Binding JobStatus}"
                                    IsReadOnly="True"
                                    Width="Auto" />

                <!-- ACTIVITY -->
                <DataGridTextColumn Header="Activity"
                                    Binding="{Binding Activity}"
                                    IsReadOnly="True"
                                    Width="Auto" />

                <!-- CREW ACTION -->
                <DataGridTextColumn Header="Crew Action"
                                    Binding="{Binding Action}"
                                    IsReadOnly="True"
                                    Width="Auto" />

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>